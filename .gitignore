__pycache__/
*.pyc

# Per-run scratch from the daily workflow. Regenerated every morning and read
# only within the run that wrote it — committing them is pure churn, and the
# durable record is scraper_log.txt plus the findings issue itself.
scraper_findings.json
duplicate_report.txt
issue_body.md

# Review workbooks never belong in the repo — they live in Alexandra's
# Documents folder. Belt and braces alongside the workflow's staging list.
*_review.xlsx

# Rendered Instagram slides — build output of render_slides.py. Regenerate from
# the approved mockup HTML; never commit the images themselves.
slides/
dashboard.html

# Rule-23 safe-write backups. In the repo git is already the backup, so these
# are transient; in the Documents folder (no VCS) they are the only one.
*.bak
*.bak[0-9]
*.tmp
